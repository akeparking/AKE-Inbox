# Add to sales-core.env; supply secrets privately, never in the repository.
INBOX_V2_ENABLED=true
INBOX_ACCOUNT_ID=1
INBOX_CHANNELS={"1":"website","2":"email","3":"whatsapp"}
INBOX_EXCLUDED_CONVERSATIONS=
INBOX_AUTO_SEND=false
INBOX_AUTO_CHANNELS=
INBOX_TEST_CONTACT_IDS=
OKKI_WRITE_ENABLED=false
INBOX_EFFECTIVE_FROM=2026-01-01T00:00:00Z
CHATWOOT_URL=http://chatwoot-web:3000
CHATWOOT_PUBLIC_URL=https://inbox.example.invalid
INBOX_MODEL_URL=http://host.docker.internal:4311
INBOX_EXPORT_ROOT=/var/lib/ake-exports
INBOX_ARCHIVE_ROOT=/var/lib/ake-archive
INBOX_PDF_FONT=/opt/ake-font.otf
INBOX_OKKI_ORIGINS={}
# Configure tenant-specific source IDs from the OKKI dictionaries before enabling writes.
AKE_SUPPRESS_NOTIFICATION_EMAIL=
