NODE_ENV=development
PORT=4100
NEXT_PUBLIC_API_URL=http://localhost:4100
SERVER_API_URL=http://revenue-core:4100
DEFAULT_WORKSPACE_ID=ake-demo
DEFAULT_USER_ID=ake-admin
DEFAULT_ROLE=admin
API_AUTH_MODE=demo
API_KEY=replace-with-a-long-random-value
STORE_DRIVER=postgres
DATABASE_URL=postgresql://ake:change-me@postgres:5432/ake_revenue
REDIS_URL=redis://redis:6379
DEMO_SEED=true
ADS_MODE=mock
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key
GOOGLE_LEAD_WEBHOOK_KEY=replace-with-google-form-key
GOOGLE_DATA_MANAGER_ACCESS_TOKEN=
GOOGLE_ADS_ACCOUNT_ID=
GOOGLE_CONVERSION_ACTION_ID=
GOOGLE_VALIDATE_ONLY=true
META_VERIFY_TOKEN=replace-with-meta-verify-token
META_APP_SECRET=
META_ACCESS_TOKEN=
META_DATASET_ID=
META_GRAPH_VERSION=v26.0
META_LEAD_EVENT_SOURCE=AKE Revenue CRM
CHATWOOT_BASE_URL=http://chatwoot:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
AI_AUTO_SEND=false
REQUIREMENT_ENGINE_URL=http://requirement-engine:4200
REQUIREMENT_ENGINE_TOKEN=replace-with-a-long-random-value
REQUIREMENT_ENGINE_TIMEOUT_MS=35000
AKE_KNOWLEDGE_ROOT=/absolute/path/to/approved-knowledge-repository
AKE_FOLLOWUP_SKILL_ROOT=/absolute/path/to/installed-followup-skill
QMD_PACKAGE_ROOT=/absolute/path/to/qmd-package
OKKI_SYNC_ENABLED=false
OKKI_BASE_URL=https://api-sandbox.xiaoman.cn
OKKI_CLIENT_ID=
OKKI_CLIENT_SECRET=
